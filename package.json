{
  "name": "@red-cup-engineering/csl-json-engineering-services-section",
  "version": "0.3.0",
  "type": "module",
  "description": "CSL-JSON (csl-data.json, CSL 1.0.2) as the org's one bibliographic record format, seated in computer-data beside JSON Schema and CloudEvents: the item type vocabulary, name and date objects, DOI normalization, title folding, item admission, and the projections of OpenAlex, PubMed, and CrossRef records into it.",
  "license": "MIT",
  "exports": {
    ".": "./src/csl-json.mjs",
    "./scripts/project-openalex-work-csl.mjs": "./scripts/project-openalex-work-csl.mjs",
    "./scripts/project-pubmed-summary-csl.mjs": "./scripts/project-pubmed-summary-csl.mjs",
    "./scripts/project-crossref-work-csl.mjs": "./scripts/project-crossref-work-csl.mjs",
    "./csl-references": "./src/csl-references.mjs",
    "./open-library": "./src/open-library.mjs",
    "./record-formatting": "./src/csl-record-formatting.mjs",
    "./projection": "./src/csl-projection.mjs",
    "./source-codec": "./src/source-codec.mjs"
  },
  "files": [
    "src/",
    "scripts/",
    "README.md",
    "docs/API.md",
    "examples/quickstart.test.mjs"
  ],
  "scripts": {
    "check": "node --check src/*.mjs && node --check scripts/project-openalex-work-csl.mjs && node --check scripts/project-pubmed-summary-csl.mjs && node --check scripts/project-crossref-work-csl.mjs && node --check test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test",
    "test:consumer": "node --test examples/quickstart.test.mjs"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "dependencies": {
    "@red-cup-engineering/json-engineering-services-section": "0.4.2",
    "@red-cup-engineering/json-schema-engineering-services-section": "^0.5.0",
    "@red-cup-engineering/html-structural-projection-service": "^0.4.1",
    "@red-cup-engineering/signcell": "0.17.5"
  },
  "keywords": [
    "csl-json",
    "csl",
    "bibliography",
    "citation",
    "json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/csl-json-engineering-services-section.git"
  },
  "private": false,
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
