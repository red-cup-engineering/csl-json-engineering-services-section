{
  "name": "@red-cup-engineering/csl-json-engineering-services-section",
  "version": "0.3.5-dev.1",
  "type": "module",
  "description": "CSL-JSON bibliography validation, citation formatting and record conversion for Markdown documents and publications.",
  "license": "MIT",
  "exports": {
    ".": "./src/csl-json.mjs",
    "./scripts/project-openalex-work-csl.mjs": "./scripts/project-openalex-work-csl.mjs",
    "./scripts/project-pubmed-summary-csl.mjs": "./scripts/project-pubmed-summary-csl.mjs",
    "./scripts/project-crossref-work-csl.mjs": "./scripts/project-crossref-work-csl.mjs",
    "./csl-references": "./src/csl-references.mjs",
    "./open-library": "./src/open-library.mjs",
    "./record-formatting": "./src/csl-record-formatting.mjs",
    "./projection": "./src/csl-projection.mjs",
    "./source-codec": "./src/source-codec.mjs"
  },
  "files": [
    "src/",
    "scripts/",
    "README.md",
    "test"
  ],
  "scripts": {
    "check": "node --check src/*.mjs && node --check scripts/project-openalex-work-csl.mjs && node --check scripts/project-pubmed-summary-csl.mjs && node --check scripts/project-crossref-work-csl.mjs",
    "verify": "npm run check",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "dependencies": {
    "@red-cup-engineering/json-engine": "^0.5.0 || 0.5.5-dev.0",
    "@red-cup-engineering/json-schema-engineering-services-section": "^0.5.7 || 0.5.14-dev.0",
    "@red-cup-engineering/html-engine": "^0.1.0 || 0.1.1-dev.0",
    "@red-cup-engineering/typed-content": "0.1.0-dev.0 || 0.1.0 || 0.1.1-dev.0"
  },
  "keywords": [
    "csl-json",
    "csl",
    "bibliography",
    "citation",
    "json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/csl-json-engineering-services-section.git"
  },
  "private": false,
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
